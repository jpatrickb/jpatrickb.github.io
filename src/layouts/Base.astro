---
import '@/styles/global.css'
// self-hosted variable fonts: no request leaves the site
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import CommandPalette from '@/components/CommandPalette'
import { nav, site } from '@/data/site'
import { themeBootScript } from '@/lib/theme'
import { themes } from '@/data/themes'
import { getPosts } from '@/lib/blog'
import { build } from '@/lib/build-info'
import { indexable } from '@/lib/site-env'

interface Props {
  title?: string
  description?: string
  // the lab is a full-screen app: no header/footer chrome
  bare?: boolean
}
const { title, description = site.description, bare = false } = Astro.props
const fullTitle = title ? `${title} · ${site.name}` : site.title
const path = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
// the Blog link only shows up in the header once there is at least one post to read
const hasPosts = (await getPosts()).length > 0
const headerNav = nav.slice(1).filter((n) => n.href !== '/blog/' || hasPosts)
const ogImage = new URL('/profile.jpeg', Astro.site).toString()
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · Blog`} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <script is:inline set:html={themeBootScript} />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-card focus:px-3 focus:py-2">Skip to content</a>
    {!bare && (
      <header class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur">
        <div class="mx-auto flex h-14 max-w-3xl items-center justify-between gap-4 px-4 sm:px-6">
          <a href="/" class="font-mono text-sm text-muted-foreground hover:text-foreground">
            <span class="text-foreground">~/{site.handle}</span>{path !== '/' && path.replace(/\/$/, '')}
          </a>
          <nav aria-label="Primary" class="flex items-center gap-1 text-sm">
            {headerNav.map((n) => (
              <a href={n.href} class:list={['group relative rounded px-2 py-1 transition-colors hover:text-foreground', isActive(n.href) ? 'text-foreground' : 'text-muted-foreground']} aria-current={isActive(n.href) ? 'page' : undefined}>
                {n.label}
                <span class="pointer-events-none absolute -bottom-5 left-1/2 hidden -translate-x-1/2 whitespace-nowrap font-mono text-[10px] text-muted-foreground group-hover:block">g {n.key}</span>
              </a>
            ))}
            <button type="button" data-action="palette" class="ml-2 hidden items-center gap-1.5 rounded-md border border-border px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground sm:inline-flex" aria-label="Open search">
              search <span class="kbd">⌘K</span>
            </button>
            <button type="button" data-action="palette" class="ml-1 rounded px-2 py-1 font-mono text-xs text-muted-foreground sm:hidden" aria-label="Open search">⌘K</button>
            <button type="button" data-action="themes" class="ml-1 rounded-md border border-border px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground" aria-label="Choose a theme" title="Choose a theme">◐</button>
          </nav>
        </div>
      </header>
    )}

    <main id="main" class:list={[!bare && 'mx-auto max-w-3xl px-4 pb-24 sm:px-6']}>
      <slot />
    </main>

    {!bare && (
      <footer class="border-t border-border">
        <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-5 font-mono text-[11px] text-muted-foreground sm:px-6">
          <span>build {build.sha} · {build.date} · static, no trackers</span>
          <span class="flex flex-wrap gap-4">
            <a href="/uses/" class="hover:text-foreground">uses</a>
            <a href="/rss.xml" class="hover:text-foreground">rss</a>
            <button type="button" data-action="themes" class="hover:text-foreground">theme: <span data-theme-name>theme</span></button>
            <button type="button" data-action="help" class="hover:text-foreground"><span class="kbd">?</span> keys</button>
          </span>
        </div>
      </footer>
    )}

    <dialog id="help-dialog" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-xl border border-border bg-popover p-0 text-foreground shadow-2xl backdrop:bg-background/60 backdrop:backdrop-blur-[3px]">
      <div class="flex items-center justify-between border-b border-border px-5 py-3">
        <h2 class="font-mono text-sm">keyboard</h2>
        <form method="dialog"><button class="font-mono text-xs text-muted-foreground hover:text-foreground">esc</button></form>
      </div>
      <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2.5 px-5 py-4 text-sm">
        <dt><span class="kbd">⌘K</span> <span class="kbd">/</span></dt><dd>Search and commands</dd>
        <dt><span class="kbd">t</span> <span class="kbd">T</span></dt><dd>Next / previous theme</dd>
        <dt><span class="kbd">j</span> <span class="kbd">k</span></dt><dd>Move through items on the page (<span class="kbd">k</span> on the first one goes back to the top)</dd>
        <dt><span class="kbd">o</span></dt><dd>Open the selected item</dd>
        <dt><span class="kbd">g</span> then <span class="kbd">h</span> <span class="kbd">w</span> <span class="kbd">p</span> <span class="kbd">b</span> <span class="kbd">a</span> <span class="kbd">l</span></dt><dd>Home, Work, Projects, Blog, About, Lab</dd>
        <dt><span class="kbd">c</span></dt><dd>Copy email</dd>
        <dt><span class="kbd">?</span></dt><dd>This list</dd>
      </dl>
    </dialog>

    <dialog id="theme-dialog" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl border border-border bg-popover p-0 text-foreground shadow-2xl backdrop:bg-background/60 backdrop:backdrop-blur-[3px]">
      <div class="flex items-center justify-between border-b border-border px-5 py-3">
        <h2 class="text-sm font-medium">Choose a theme</h2>
        <form method="dialog"><button class="font-mono text-xs text-muted-foreground hover:text-foreground">esc</button></form>
      </div>
      <div class="max-h-[70vh] space-y-4 overflow-y-auto px-5 py-4">
        {[{ title: 'Dark', dark: true }, { title: 'Light', dark: false }].map((group) => (
          <section>
            <h3 class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">{group.title}</h3>
            <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3">
              {themes.filter((t) => t.dark === group.dark).map((t) => (
                <button type="button" class="theme-card" data-set-theme={t.id} aria-pressed="false">
                  <span class="preview" style={`background:${t.swatch[0]};color:${t.swatch[1]}`}>
                    <i style={`background:${t.swatch[1]};width:62%`} />
                    <i style={`background:${t.swatch[2]};width:44%`} />
                    <i style={`background:${t.swatch[3]};width:28%`} />
                  </span>
                  <span class="mt-1.5 block px-0.5 text-xs">{t.name}</span>
                </button>
              ))}
            </div>
          </section>
        ))}
        <p class="text-xs text-muted-foreground">You can also press <span class="kbd">t</span> to step through them.</p>
      </div>
    </dialog>

    <CommandPalette client:idle />
    <script>
      import '@/scripts/keys'
    </script>
  </body>
</html>
