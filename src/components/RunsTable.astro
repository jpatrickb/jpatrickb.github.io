---
import type { CollectionEntry } from 'astro:content'
interface Props { runs: CollectionEntry<'work'>[]; link?: boolean }
const { runs, link = false } = Astro.props
---
<div class="overflow-x-auto">
  <table class="w-full min-w-[540px] border-collapse text-sm">
    <thead>
      <tr class="border-b border-border text-left font-mono text-[11px] text-muted-foreground">
        <th class="py-2 pr-3 font-normal">role</th>
        <th class="py-2 pr-3 font-normal"><span class="sr-only">status</span></th>
        <th class="py-2 pr-3 font-normal">dates</th>
        <th class="py-2 font-normal">highlight</th>
      </tr>
    </thead>
    <tbody>
      {runs.map((r) => (
        <tr data-nav-item class="border-b border-border/60 align-top">
          <td class="py-2.5 pr-3">
            {link ? <a href={`/work/#${r.id}`} class="font-medium hover:text-primary">{r.data.company}</a> : <span class="font-medium">{r.data.company}</span>}
            <div class="text-[13px] text-muted-foreground">{r.data.role}</div>
          </td>
          <td class="py-2.5 pr-3">
            {r.data.status === 'running' && (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-secondary-accent/50 px-2 py-0.5 font-mono text-[11px] text-secondary-accent">
                <span class="size-1.5 rounded-full bg-secondary-accent" />
                current
              </span>
            )}
          </td>
          <td class="whitespace-nowrap py-2.5 pr-3 font-mono text-xs tabular-nums text-muted-foreground">{r.data.start} – {r.data.end}</td>
          <td class="py-2.5 font-mono text-xs tabular-nums">
            {r.data.metrics[0] ? <><span class="text-foreground">{r.data.metrics[0].value}</span> <span class="text-muted-foreground">{r.data.metrics[0].label}</span></> : <span class="text-muted-foreground">—</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
