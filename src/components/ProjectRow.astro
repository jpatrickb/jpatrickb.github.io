---
import type { CollectionEntry } from 'astro:content'
import PipelineStrip from './PipelineStrip.astro'
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props
const p = project.data
---
<li data-nav-item class="group -mx-3 rounded-md px-3 py-4 transition-colors hover:bg-muted/50">
  <div class="flex items-baseline justify-between gap-4">
    <a href={`/projects/${project.id}/`} class="font-medium after:absolute after:inset-0 group-hover:text-primary relative">{p.title}</a>
    <span class="shrink-0 font-mono text-[11px] text-muted-foreground">{p.lane}{p.year ? ` · ${p.year}` : ''}</span>
  </div>
  <p class="mt-1 max-w-[62ch] text-sm leading-relaxed text-muted-foreground">{p.summary}</p>
  {p.outcome && <p class="mt-1.5 max-w-[62ch] text-sm"><span class="font-mono text-[11px] text-secondary-accent">result</span> {p.outcome}</p>}
  {p.stages.length > 0 && <div class="mt-2.5"><PipelineStrip stages={p.stages} /></div>}
</li>
