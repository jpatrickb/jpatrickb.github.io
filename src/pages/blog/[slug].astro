---
import { render } from 'astro:content'
import Base from '@/layouts/Base.astro'
import { formatDate, getPosts, tagSlug, type Post } from '@/lib/blog'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}
interface Props { post: Post }
const { post } = Astro.props
const { Content } = await render(post)
---
<Base title={post.data.title} description={post.data.description}>
  <article class="pt-14">
    <a href="/blog/" class="font-mono text-xs text-muted-foreground hover:text-primary">← blog</a>
    <h1 class="mt-8 text-3xl font-semibold tracking-tight">{post.data.title}</h1>
    <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted-foreground">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.tags.map((t) => <a href={`/blog/tags/${tagSlug(t)}/`} class="rounded border border-border px-1.5 py-0.5 hover:text-foreground">{t}</a>)}
      {post.data.draft && <span class="rounded border border-border px-1.5 py-0.5">draft, not published</span>}
    </p>
    <div class="prose-site mt-8"><Content /></div>
  </article>
</Base>
