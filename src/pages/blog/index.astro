---
import Base from '@/layouts/Base.astro'
import PostList from '@/components/PostList.astro'
import { getPosts } from '@/lib/blog'

const posts = await getPosts()
---
<Base title="Blog" description="Posts by Patrick Beal about things he is building, learning, and cooking.">
  <header class="pb-6 pt-14">
    <p class="label mb-3">blog</p>
    <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
    <p class="mt-3 max-w-[60ch] text-muted-foreground">
      Things I'm building and learning, along with some posts that have nothing to do with work. You can also follow along
      with the <a class="link" href="/rss.xml">RSS feed</a>.
    </p>
  </header>
  <section class="border-t border-border py-6">
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="text-muted-foreground">I haven't published anything here yet, but I'm working on it!</p>}
  </section>
</Base>
