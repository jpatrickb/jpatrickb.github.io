---
import { getCollection, render } from 'astro:content'
import Base from '@/layouts/Base.astro'
import RunsTable from '@/components/RunsTable.astro'

const all = (await getCollection('work', (w) => !w.data.draft)).sort((a, b) => a.data.order - b.data.order)
const tracked = all.filter((w) => w.data.kind === 'engineering' || w.data.kind === 'research')
const rendered = await Promise.all(all.map(async (w) => ({ entry: w, Content: (await render(w)).Content })))
const kindLabel = { engineering: 'engineering', research: 'research', music: 'music', other: 'other' } as const
---
<Base title="Work" description="Patrick Beal's experience: founding engineer building AI systems on AWS, ML and research roles, and music.">
  <header class="pb-8 pt-14">
    <p class="label mb-3">work</p>
    <h1 class="text-3xl font-semibold tracking-tight">Experience, tracked like experiments</h1>
    <p class="mt-3 max-w-[60ch] text-muted-foreground">Each role is a run: what it set out to do, how long it went, and what it produced. Full details are below the table, and the <a class="link" href="/resume.pdf">resume PDF</a> has the same content.</p>
  </header>

  <RunsTable runs={tracked} link />

  <div class="mt-14 space-y-12">
    {rendered.map(({ entry, Content }) => (
      <article id={entry.id} class="scroll-mt-20" data-nav-item>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-lg font-semibold">{entry.data.role}</h2>
          <span class="font-mono text-xs tabular-nums text-muted-foreground">{entry.data.start} – {entry.data.end}</span>
        </div>
        <p class="text-muted-foreground">{entry.data.company}{entry.data.location && ` · ${entry.data.location}`} <span class="ml-1 font-mono text-[11px]">[{kindLabel[entry.data.kind]}]</span></p>
        {entry.data.metrics.length > 0 && (
          <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
            {entry.data.metrics.map((m) => (
              <div>
                <dt class="font-mono text-[11px] text-muted-foreground">{m.label}</dt>
                <dd class="font-mono text-base tabular-nums">{m.value}</dd>
              </div>
            ))}
          </dl>
        )}
        <div class="prose-site mt-4 text-[15px]"><Content /></div>
        {entry.data.tags.length > 0 && (
          <p class="mt-1 flex flex-wrap gap-1.5">
            {entry.data.tags.map((t) => <span class="rounded border border-border px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground">{t}</span>)}
          </p>
        )}
      </article>
    ))}
  </div>

  <section class="mt-14 border-t border-border pt-8">
    <h2 class="label mb-3">education</h2>
    <p class="font-medium">Brigham Young University · BS, Applied & Computational Mathematics + Economics</p>
    <p class="mt-1 text-sm text-muted-foreground">Apr 2026 · GPA 3.92 · <a class="link" href="https://wheatley.byu.edu/student-scholars">Wheatley Scholar</a> (2024 cohort) · Dean's List (4×)</p>
    <p class="mt-1 text-sm text-muted-foreground">Optimization, algorithms, machine learning, PDEs/ODEs and optimal control, econometrics, software development</p>
  </section>
</Base>
